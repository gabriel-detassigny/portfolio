# Copied into dist/ by the deploy workflow.

ErrorDocument 404 /404.html
Options -Indexes

RewriteEngine On

# HTTPS and no www (OVH sets the HTTPS environment variable rather than %{HTTPS}).
RewriteCond %{ENV:HTTPS} !on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://detassigny.net%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------------------------
# The blog used to be served on detassigny.net too. It now lives only on
# blog.detassigny.net, so send its old URLs there in a single hop.
# Check with: scripts/check-redirects.sh
# ---------------------------------------------------------------------------

# Posts (the blog's own legacy /posts/{id} URLs go straight to the post).
RewriteRule ^posts/1(/.*)?$ https://blog.detassigny.net/design-pattern-1-value-object/ [R=301,L]
RewriteRule ^posts/2(/.*)?$ https://blog.detassigny.net/going-frameworkless/ [R=301,L]
RewriteRule ^posts/3(/.*)?$ https://blog.detassigny.net/managing-my-passwords-with-keepass-and-owncloud/ [R=301,L]
RewriteRule ^posts/4(/.*)?$ https://blog.detassigny.net/design-pattern-2-dependency-injection/ [R=301,L]
RewriteRule ^posts/5(/.*)?$ https://blog.detassigny.net/i-gave-up-on-android/ [R=301,L]
RewriteRule ^posts/6(/.*)?$ https://blog.detassigny.net/you-need-to-write-tests/ [R=301,L]
RewriteRule ^posts/7(/.*)?$ https://blog.detassigny.net/mocking-in-php-1-writing-your-own-mocks/ [R=301,L]
RewriteRule ^posts/8(/.*)?$ https://blog.detassigny.net/mocking-in-php-2-phpunit-mocks/ [R=301,L]
RewriteRule ^posts/9(/.*)?$ https://blog.detassigny.net/mocking-in-php-3-mockery/ [R=301,L]
RewriteRule ^posts/10(/.*)?$ https://blog.detassigny.net/mocking-in-php-4-phake/ [R=301,L]
RewriteRule ^posts/11(/.*)?$ https://blog.detassigny.net/design-pattern-3-decorator-pattern/ [R=301,L]
RewriteRule ^posts/12(/.*)?$ https://blog.detassigny.net/safe-refactoring-split-a-class-into-smaller-ones/ [R=301,L]
RewriteRule ^posts/page/[0-9]+/?$ https://blog.detassigny.net/ [R=301,L]
RewriteRule ^rss/?$ https://blog.detassigny.net/feed_rss_created.xml [R=301,L]
RewriteRule ^about/?$ https://blog.detassigny.net/about/ [R=301,L]
RewriteRule ^images/upload/(.*)$ https://blog.detassigny.net/images/$1 [R=301,L]

# Posts published since the move to Zensical, served at /<slug>/.
RewriteRule ^(design-pattern-1-value-object|going-frameworkless|managing-my-passwords-with-keepass-and-owncloud|design-pattern-2-dependency-injection|i-gave-up-on-android|you-need-to-write-tests|mocking-in-php-1-writing-your-own-mocks|mocking-in-php-2-phpunit-mocks|mocking-in-php-3-mockery|mocking-in-php-4-phake|design-pattern-3-decorator-pattern|safe-refactoring-split-a-class-into-smaller-ones|zensical-migration)(/.*)?$ https://blog.detassigny.net/$1/ [R=301,L]

# Blog listing pages, feeds and files.
RewriteRule ^(archive|page|images|assets)(/.*)?$ https://blog.detassigny.net/$1$2 [R=301,L]
RewriteRule ^(feed_rss_created\.xml|feed_rss_updated\.xml|feed_json_created\.json|feed_json_updated\.json|rss\.xsl|search\.json)$ https://blog.detassigny.net/$1 [R=301,L]

# ---------------------------------------------------------------------------
# Headers and caching
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
	Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"

	# Hashed build assets never change; everything else is revalidated.
	<If "%{REQUEST_URI} =~ m#^/_astro/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
	<Else>
		Header set Cache-Control "public, max-age=0, must-revalidate"
	</Else>
</IfModule>

<IfModule mod_mime.c>
	AddType application/manifest+json .webmanifest
	AddType font/woff2 .woff2
</IfModule>
