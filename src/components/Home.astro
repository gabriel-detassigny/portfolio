---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Experience from './Experience.astro';
import Projects from './Projects.astro';
import OpenSource from './OpenSource.astro';
import Writing from './Writing.astro';
import Skills from './Skills.astro';
import Services from './Services.astro';
import Contact from './Contact.astro';
import { profile } from '../data/profile';
import { useTranslations, yearsOfExperience, type Locale } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Base
	locale={locale}
	title={t('meta.title')}
	description={t('meta.description', { years: yearsOfExperience(profile.careerStart) })}
>
	<Hero locale={locale} />
	<Experience locale={locale} />
	<Projects locale={locale} />
	<OpenSource locale={locale} />
	<Writing locale={locale} />
	<Skills locale={locale} />
	<Services locale={locale} />
	<Contact locale={locale} />
</Base>
