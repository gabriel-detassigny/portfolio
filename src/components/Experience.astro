---
import { getCollection } from 'astro:content';
import { FILTERS } from '../content.config';
import { formatMonth, useTranslations, type Locale } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const roles = (await getCollection('experience')).sort((a, b) => b.data.start.localeCompare(a.data.start));
const education = (await getCollection('education')).sort((a, b) => b.data.end - a.data.end);
const certifications = (await getCollection('certifications')).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<section class="section wrap" id="experience" aria-labelledby="experience-title">
	<p class="prompt">
		<b>$&gt;</b> git log --career
	</p>
	<h2 class="section-title" id="experience-title">
		{t('experience.title')}
	</h2>

	<div class="filters" role="group" aria-label={t('experience.filter')} data-filters hidden>
		<button class="chip" type="button" aria-pressed="true" data-filter="all">
			{t('experience.all')}
		</button>
		{FILTERS.map((filter) => (
			<button class="chip" type="button" aria-pressed="false" data-filter={filter}>
				{t(`filter.${filter}`)}
			</button>
		))}
	</div>

	<ol class="log">
		{roles.map((role, index) => (
			<li class:list={['commit', { head: index === 0 }]} data-tech={role.data.filters.join(' ')}>
				<p class="meta">
					<span>
						{formatMonth(locale, role.data.start)} –{' '}
						{role.data.end ? formatMonth(locale, role.data.end) : t('experience.present')}
					</span>
					<span class="ref">({role.data.ref})</span>
					<span>{role.data.location[locale]}</span>
				</p>
				<h3>
					{role.data.role[locale]}{' '}
					<span>
						· {role.data.companyUrl ? <a href={role.data.companyUrl}>{role.data.company}</a> : role.data.company}
					</span>
				</h3>
				<ul class="highlights">
					{role.data.highlights[locale].map((highlight) => (
						<li>{highlight}</li>
					))}
				</ul>
				<ul class="tags">
					{role.data.stack.map((tech) => (
						<li class="tag">{tech}</li>
					))}
				</ul>
			</li>
		))}
	</ol>

	<h3 class="sub">{t('experience.certifications')}</h3>
	<ul class="education">
		{certifications.map((cert) => (
			<li>
				<span class="years">{formatMonth(locale, cert.data.date)}</span>
				<span>
					<a href={cert.data.url}>
						<strong>{cert.data.name}</strong>
					</a>{' '}
					· {cert.data.issuer}
				</span>
			</li>
		))}
	</ul>

	<h3 class="sub">{t('experience.education')}</h3>
	<ul class="education">
		{education.map((entry) => (
			<li>
				<span class="years">
					{entry.data.start} – {entry.data.end}
				</span>
				<span>
					<strong>{entry.data.degree[locale]}</strong> ·{' '}
					{entry.data.url ? <a href={entry.data.url}>{entry.data.school}</a> : entry.data.school}, {entry.data.location}
				</span>
			</li>
		))}
	</ul>
</section>

<script>
	const group = document.querySelector<HTMLElement>('[data-filters]');
	if (group) {
		group.hidden = false;
		const chips = group.querySelectorAll<HTMLButtonElement>('[data-filter]');
		const commits = document.querySelectorAll<HTMLElement>('.commit');
		chips.forEach((chip) =>
			chip.addEventListener('click', () => {
				const filter = chip.dataset.filter!;
				chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));
				commits.forEach((commit) => {
					const match = filter === 'all' || commit.dataset.tech!.split(' ').includes(filter);
					commit.classList.toggle('dim', !match);
				});
			}),
		);
	}
</script>

<style>
	.filters {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
		margin-bottom: 1.75rem;
	}
	.chip {
		font: 500 0.78rem var(--font-mono);
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: transparent;
		color: var(--muted);
		cursor: pointer;
	}
	.chip:hover {
		border-color: var(--muted);
		color: var(--ink);
	}
	.chip[aria-pressed='true'] {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}
	.log {
		list-style: none;
		margin: 0;
		padding: 0;
		position: relative;
	}
	.log::before {
		content: '';
		position: absolute;
		left: 0.45rem;
		top: 0.6rem;
		bottom: 1.5rem;
		width: 2px;
		background: var(--line);
	}
	.commit {
		position: relative;
		padding-left: 2.25rem;
		padding-bottom: 2rem;
	}
	.commit::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.35rem;
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--accent);
	}
	.commit.head::before {
		background: var(--accent);
	}
	.commit.dim {
		opacity: 0.35;
	}
	@media (prefers-reduced-motion: no-preference) {
		.commit {
			transition: opacity 0.2s;
		}
	}
	.meta {
		display: flex;
		gap: 0.25rem 0.75rem;
		flex-wrap: wrap;
		margin: 0;
		font: 400 0.82rem var(--font-mono);
		color: var(--muted);
	}
	.ref {
		color: var(--signal);
	}
	.commit h3 {
		font: 700 1.2rem/1.3 var(--font-display);
		margin: 0.25rem 0 0;
	}
	.commit h3 span,
	.commit h3 a {
		color: var(--muted);
		font-weight: 500;
	}
	.highlights {
		margin: 0.5rem 0 0.75rem;
		padding-left: 1.1rem;
		color: var(--muted);
		font-size: 0.95rem;
		max-width: 46rem;
	}
	.sub {
		font: 700 1.1rem var(--font-display);
		margin: 1rem 0 0.75rem;
	}
	.education {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
		font-size: 0.95rem;
	}
	.education li {
		display: flex;
		gap: 0.25rem 1rem;
		flex-wrap: wrap;
	}
	.years {
		font: 400 0.82rem/1.9 var(--font-mono);
		color: var(--muted);
		min-width: 7.5rem;
	}
</style>
