---
import ProjectPage from '../../../components/ProjectPage.astro';
import { getProjects, projectSlug, type Project } from '../../../lib/projects';

export async function getStaticPaths() {
	const projects = await getProjects('fr');
	return projects.map((project) => ({ params: { slug: projectSlug(project) }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
---

<ProjectPage locale="fr" project={project} />
