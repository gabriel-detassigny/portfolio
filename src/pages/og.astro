---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/ibm-plex-mono/400.css';
import { profile } from '../data/profile';

// Rendered to /og.png (1200×630) by scripts/render-assets.mjs, for link previews.
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex" />
		<title>Social preview</title>
	</head>
	<body>
		<p class="prompt">
			<b>$&gt;</b> whoami
		</p>
		<h1>{profile.name}</h1>
		<p class="role">Senior Staff Engineer · PHP, Symfony & WordPress</p>
		<p class="url">detassigny.net</p>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 1200px;
		height: 630px;
	}
	body {
		box-sizing: border-box;
		padding: 90px 96px;
		background: #0f1222;
		color: #e6e8f5;
		display: flex;
		flex-direction: column;
		justify-content: center;
		font-family: 'IBM Plex Mono', monospace;
	}
	.prompt {
		font-size: 30px;
		color: #a2a7c6;
		margin: 0;
	}
	.prompt b {
		color: #a3a6ff;
		font-weight: 400;
	}
	h1 {
		font:
			700 96px/1 'Bricolage Grotesque Variable',
			sans-serif;
		letter-spacing: -0.02em;
		margin: 24px 0 0;
	}
	.role {
		font:
			500 38px/1.3 'Bricolage Grotesque Variable',
			sans-serif;
		color: #a2a7c6;
		margin: 24px 0 0;
	}
	.url {
		margin: auto 0 0;
		font-size: 28px;
		color: #f2b54a;
	}
</style>
