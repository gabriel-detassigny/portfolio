---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { localizePath, useTranslations, type Locale } from '../i18n/ui';
import { getProjectRepoStats, type Project } from '../lib/projects';

interface Props {
	locale: Locale;
	project: Project;
}

const { locale, project } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(project);
const stats = project.data.repo ? (await getProjectRepoStats())[project.data.repo] : undefined;
---

<Base locale={locale} title={`${project.data.title} · Gabriel de Tassigny`} description={project.data.summary}>
	<article class="wrap project">
		<a class="back" href={`${localizePath(locale)}#projects`}>
			← {t('projects.back')}
		</a>
		<p class="kind">{project.data.kind}</p>
		<h1>{project.data.title}</h1>
		<p class="summary">{project.data.summary}</p>
		<ul class="tags">
			{project.data.tags.map((tag) => (
				<li class="tag">{tag}</li>
			))}
		</ul>
		<p class="links">
			{project.data.url && (
				<a class="btn btn-primary" href={project.data.url}>
					{t('projects.live')}
				</a>
			)}
			{project.data.repo && (
				<a class="btn btn-ghost" href={`https://github.com/${project.data.repo}`}>
					{t('projects.repo')}
					{stats && stats.stars > 0 && ` · ★ ${stats.stars}`}
				</a>
			)}
		</p>
		<div class="body">
			<Content />
		</div>
	</article>
</Base>

<style>
	.project {
		padding-block: 2.5rem 4rem;
	}
	.back {
		font: 400 0.85rem var(--font-mono);
		text-decoration: none;
	}
	.kind {
		font: 500 0.75rem var(--font-mono);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		margin: 2rem 0 0;
	}
	h1 {
		font: 700 clamp(2.2rem, 5vw, 3.4rem) / 1.05 var(--font-display);
		letter-spacing: -0.02em;
		margin: 0.4rem 0 0;
	}
	.summary {
		font-size: 1.15rem;
		color: var(--muted);
		max-width: 42rem;
		margin: 1rem 0 1.25rem;
	}
	.links {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
		margin: 1.5rem 0 0;
	}
	.body {
		max-width: 42rem;
		margin-top: 2.5rem;
		padding-top: 0.5rem;
		border-top: 1px solid var(--line);
	}
	.body :global(h2) {
		font: 700 1.4rem/1.3 var(--font-display);
		margin: 2rem 0 0.5rem;
	}
	.body :global(li) {
		margin-bottom: 0.4rem;
	}
</style>
