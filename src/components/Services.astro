---
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../i18n/ui';
import { getProjects, projectPath, projectSlug } from '../lib/projects';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const projects = await getProjects(locale);
const findProject = (slug?: string) => projects.find((project) => projectSlug(project) === slug);
---

<section class="section wrap" id="services" aria-labelledby="services-title">
	<p class="prompt">
		<b>$&gt;</b> man hire
	</p>
	<h2 class="section-title" id="services-title">
		{t('services.title')}
	</h2>
	<p class="intro">{t('services.intro')}</p>
	<ul class="grid">
		{services.map((service) => {
			const proof = findProject(service.data.proof);
			return (
				<li class="card">
					<h3>{service.data.title[locale]}</h3>
					<p>{service.data.description[locale]}</p>
					{proof && (
						<a class="proof" href={projectPath(locale, proof)}>
							{t('services.proof', { project: proof.data.title })} →
						</a>
					)}
				</li>
			);
		})}
	</ul>
</section>

<style>
	.intro {
		max-width: 40rem;
		color: var(--muted);
		margin: -0.75rem 0 1.75rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	h3 {
		font: 700 1.15rem/1.3 var(--font-display);
		margin: 0;
	}
	p {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
		flex: 1;
	}
	.proof {
		font: 400 0.8rem var(--font-mono);
	}
</style>
