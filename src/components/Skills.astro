---
import { profile, skills } from '../data/profile';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section wrap" id="skills" aria-labelledby="skills-title">
	<p class="prompt">
		<b>$&gt;</b> composer show --tree
	</p>
	<h2 class="section-title" id="skills-title">
		{t('skills.title')}
	</h2>
	<dl class="skills">
		{skills.map((skill) => (
			<div>
				<dt>{skill.group[locale]}</dt>
				<dd>
					<ul class="tags">
						{skill.items.map((item) => (
							<li class="tag">{item}</li>
						))}
					</ul>
				</dd>
			</div>
		))}
		<div>
			<dt>{t('skills.languages')}</dt>
			<dd>
				<ul class="tags">
					{profile.languages.map((language) => (
						<li class="tag">{language[locale]}</li>
					))}
				</ul>
			</dd>
		</div>
	</dl>
</section>

<style>
	.skills {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
		gap: 1.5rem 2rem;
		margin: 0;
	}
	dt {
		font: 700 1.05rem var(--font-display);
		margin-bottom: 0.5rem;
	}
	dd {
		margin: 0;
	}
</style>
