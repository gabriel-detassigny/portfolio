---
import { alternatePath, localizePath, useTranslations, type Locale } from '../i18n/ui';

interface Props {
	locale: Locale;
	translated: boolean;
}

const { locale, translated } = Astro.props;
const t = useTranslations(locale);
const home = localizePath(locale);
const otherLocale: Locale = locale === 'en' ? 'fr' : 'en';
const sections = [
	['experience', t('nav.experience')],
	['projects', t('nav.projects')],
	['open-source', t('nav.openSource')],
	['writing', t('nav.writing')],
	['contact', t('nav.contact')],
] as const;
---

<a class="skip" href="#main">
	{t('nav.skip')}
</a>
<header class="wrap nav">
	<a class="brand" href={home}>
		<span aria-hidden="true">$&gt;</span> detassigny.net
	</a>
	<nav aria-label={t('nav.main')}>
		<ul>
			{sections.map(([id, label]) => (
				<li>
					<a href={`${home}#${id}`}>{label}</a>
				</li>
			))}
		</ul>
	</nav>
	<div class="tools">
		{translated && (
			<a class="pill" href={alternatePath(Astro.url.pathname, otherLocale)} hreflang={otherLocale} lang={otherLocale}>
				{t('nav.otherLanguage')}
			</a>
		)}
		<button class="pill theme" type="button" aria-label={t('theme.toggle')} data-theme-toggle>
			<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
				<path
					fill="currentColor"
					d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-9.54-4.5c.31-1.06.97-1.98 1.84-2.62A9.23 9.23 0 0 0 12 3Z"
				></path>
			</svg>
		</button>
	</div>
</header>

<script>
	const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const root = document.documentElement;
	const isDark = () =>
		root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
	const sync = () => button?.setAttribute('aria-pressed', String(isDark()));
	sync();
	button?.addEventListener('click', () => {
		const next = isDark() ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
		sync();
	});
</script>

<style>
	.skip {
		position: absolute;
		left: 1rem;
		top: -3rem;
		background: var(--accent);
		color: var(--bg);
		padding: 0.5rem 0.9rem;
		border-radius: 0.5rem;
		z-index: 10;
	}
	.skip:focus {
		top: 1rem;
	}
	.nav {
		display: flex;
		align-items: center;
		gap: 1rem 1.5rem;
		padding-block: 1.25rem;
		flex-wrap: wrap;
	}
	.brand {
		font: 500 0.95rem var(--font-mono);
		color: var(--ink);
		text-decoration: none;
		margin-right: auto;
	}
	.brand span {
		color: var(--accent);
	}
	ul {
		display: flex;
		gap: 0.4rem 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 0.9rem;
		flex-wrap: wrap;
	}
	ul a {
		color: var(--muted);
		text-decoration: none;
	}
	ul a:hover {
		color: var(--ink);
	}
	.tools {
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}
	.pill {
		font: 500 0.8rem var(--font-mono);
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 0.3rem 0.7rem;
		color: var(--muted);
		background: transparent;
		text-decoration: none;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
	}
	.pill:hover {
		color: var(--ink);
		border-color: var(--muted);
	}
	@media (max-width: 760px) {
		nav {
			order: 3;
			width: 100%;
		}
	}
</style>
