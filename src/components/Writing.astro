---
import { profile } from '../data/profile';
import { formatDate, useTranslations, type Locale } from '../i18n/ui';
import { getRecentPosts } from '../lib/blog';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = await getRecentPosts();
---

<section class="section wrap" id="writing" aria-labelledby="writing-title">
	<p class="prompt">
		<b>$&gt;</b> tail ~/blog
	</p>
	<h2 class="section-title" id="writing-title">
		{t('writing.title')}
	</h2>
	{posts.length > 0 ? (
		<ul class="posts">
			{posts.map((post) => (
				<li>
					<time datetime={post.date}>{formatDate(locale, post.date)}</time>
					<a href={post.url} lang="en">
						{post.title}
					</a>
					{post.summary && <p lang="en">{post.summary}</p>}
				</li>
			))}
		</ul>
	) : (
		<p class="empty">{t('writing.empty')}</p>
	)}
	<a class="btn btn-ghost" href={profile.links.blog}>
		{t('writing.more')} →
	</a>
</section>

<style>
	.posts {
		list-style: none;
		margin: 0 0 1.5rem;
		padding: 0;
		display: grid;
		gap: 1.25rem;
		max-width: 46rem;
	}
	.posts li {
		display: grid;
		gap: 0.15rem;
	}
	time {
		font: 400 0.8rem var(--font-mono);
		color: var(--muted);
	}
	.posts a {
		font: 700 1.15rem/1.35 var(--font-display);
		color: var(--ink);
		text-decoration: none;
	}
	.posts a:hover {
		color: var(--accent);
	}
	.posts p {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.empty {
		max-width: 40rem;
		color: var(--muted);
		margin: 0 0 1.25rem;
	}
</style>
